#!/usr/bin/env python3
# Stand-in unshare for rehearsals of the root helper (deploy/spark-console-root; test/root-helper.test.mjs). Outside a
# rehearsal (SPARK_CONSOLE_REHEARSAL naming its folder) it fails. Every call is one JSON line in <rehearsal>/calls.log.
# It makes no namespace: it checks that it knows each option, then runs the rest of the command as it is. --help shows
# the options the helper looks for; with <rehearsal>/standin/unshare-old it lacks --kill-child, as an old one would.
import json, os, sys

R = os.environ.get('SPARK_CONSOLE_REHEARSAL', '')
if not R.startswith('/') or not os.path.isdir(R):
    sys.stderr.write('unshare: this stand-in only answers inside a rehearsal of the root helper\n')
    sys.exit(1)
args = sys.argv[1:]
with open(os.path.join(R, 'calls.log'), 'a') as f:
    f.write(json.dumps(['unshare'] + args) + '\n')
known = ['--pid', '--fork', '--kill-child', '--mount-proc']
if os.path.exists(os.path.join(R, 'standin', 'unshare-old')):
    known.remove('--kill-child')
if args == ['--help']:
    print('Usage:\n unshare [options] [<program> [<argument>...]]\n\nOptions:\n' + ''.join(f' {o}\n' for o in known))
    sys.exit(0)
while args and args[0].startswith('-'):
    if args[0] not in known:
        sys.stderr.write(f'unshare: unrecognized option {args[0]!r}\n')
        sys.exit(1)
    args = args[1:]
if not args:
    sys.exit(1)
os.execv(args[0], args)
