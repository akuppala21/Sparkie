#!/usr/bin/env python3
# Stand-in systemctl for rehearsals of the root helper (deploy/spark-console-root; test/root-helper.test.mjs). Outside a
# rehearsal (SPARK_CONSOLE_REHEARSAL naming its folder) it fails. Every call is one JSON line in <rehearsal>/calls.log.
# It answers the helper's four questions and nothing else: the running systemd's version (from
# <rehearsal>/standin/systemd-version, else 255.4-1ubuntu8.4), a unit's main process (4242; 0 with
# <rehearsal>/standin/no-pid), whether a unit is active (yes; no with <rehearsal>/standin/target-dead), and stop (does
# nothing). And the one-time command's read of a unit's program (show --user), from <rehearsal>/standin/user-units,
# one per line: "<unit> <program>" (nothing without it). The lock-out net's: a unit's ActiveState (a net's timer is
# active while <rehearsal>/standin/timers/<unit> is there, as the stand-in systemd-run leaves it; any other unit is
# inactive, but one a test marks running with <rehearsal>/standin/active/<unit>); stop of a net's timer takes that away
# (it fails with <rehearsal>/standin/timer-stop-fails); stop and kill of a unit end it; and try-reload-or-restart,
# restart, daemon-reload and try-restart, the user manager's too, which do nothing. A way-in unit (A13b) a test
# writes as <rehearsal>/standin/units/<unit> ("<active> <file>", as "active enabled") is shown by show
# --property=ActiveState,UnitFileState,LoadState, and start, stop, restart, enable, disable, mask and unmask change it
# (--no-block too); one with no such file is not-found.
# A look's or a change's unit (sw-look-, sw-run-) is active
# while the stand-in systemd-run runs it. Called with no rehearsal named, on a stand-in Spark with ~/.rehearsal, it
# answers from that one.
import json, os, sys

R = os.environ.get('SPARK_CONSOLE_REHEARSAL', '')
# (a stand-in Spark's own rehearsal, ~/.rehearsal, when the caller names none: the console asking it a question)
if not R and os.path.isdir(os.path.join(os.environ.get('HOME', '/nonexistent'), '.rehearsal')):
    R = os.path.realpath(os.path.join(os.environ['HOME'], '.rehearsal'))
if not R.startswith('/') or not os.path.isdir(R):
    sys.stderr.write('systemctl: this stand-in only answers inside a rehearsal of the root helper\n')
    sys.exit(1)
args = sys.argv[1:]
with open(os.path.join(R, 'calls.log'), 'a') as f:
    f.write(json.dumps(['systemctl'] + args) + '\n')
args = [a for a in args if a not in ('--', '--no-block')]
units = os.path.join(R, 'standin', 'units')


def unit(name):
    try:
        with open(os.path.join(units, name)) as f:
            return f.read().split()
    except OSError:
        return None


def set_unit(name, active=None, file=None):
    u = unit(name)
    if u is None:
        return
    with open(os.path.join(units, name), 'w') as f:
        f.write(f'{active or u[0]} {file or u[1]}\n')
timers, running = os.path.join(R, 'standin', 'timers'), os.path.join(R, 'standin', 'active')


def ended(unit):
    try:
        os.unlink(os.path.join(running, unit))
    except FileNotFoundError:
        pass
try:
    with open(os.path.join(R, 'standin', 'systemd-version')) as f:
        version = f.read().strip()
except OSError:
    version = '255.4-1ubuntu8.4'
if args == ['show', '--property=Version', '--value']:
    print(version)
elif args[:3] == ['show', '--property=MainPID', '--value'] and len(args) == 4:
    print(0 if os.path.exists(os.path.join(R, 'standin', 'no-pid')) else 4242)
elif args[:2] == ['is-active', '--quiet'] and len(args) == 3 and args[2].startswith(('sw-run-', 'sw-look-')):
    sys.exit(0 if os.path.exists(os.path.join(R, 'standin', 'live', args[2].removesuffix('.service'))) else 3)
elif args[:2] == ['is-active', '--quiet'] and len(args) == 3:
    sys.exit(3 if os.path.exists(os.path.join(R, 'standin', 'target-dead')) else 0)
elif args[:2] == ['show', '--property=ActiveState,UnitFileState,LoadState'] and len(args) == 3:
    u = unit(args[2])
    print(f'ActiveState={u[0]}\nUnitFileState={u[1]}\nLoadState=loaded' if u else 'ActiveState=inactive\nUnitFileState=\nLoadState=not-found')
elif args[:3] == ['show', '--property=ActiveState', '--value'] and len(args) == 4:
    print('active' if os.path.exists(os.path.join(timers, args[3])) or os.path.exists(os.path.join(running, args[3]))
          or (unit(args[3]) or ['inactive'])[0] == 'active' else 'inactive')
elif args[:1] in (['start'], ['restart']) and len(args) == 2 and unit(args[1]):
    set_unit(args[1], active='active')
elif args[:1] in (['enable'], ['disable'], ['mask'], ['unmask']) and len(args) == 2:
    set_unit(args[1], file={'enable': 'enabled', 'disable': 'disabled', 'mask': 'masked', 'unmask': 'disabled'}[args[0]])
elif args[:1] == ['stop'] and len(args) == 2 and args[1].startswith('sw-guard-'):
    if os.path.exists(os.path.join(R, 'standin', 'timer-stop-fails')):
        sys.stderr.write('Failed to stop: Access denied\n')
        sys.exit(1)
    try:
        os.unlink(os.path.join(timers, args[1]))
    except FileNotFoundError:
        pass
elif args[:1] == ['stop'] and len(args) == 2:
    ended(args[1])
    set_unit(args[1], active='inactive')
elif args[:1] == ['kill']:
    ended(args[-1])
elif args[:1] and args[0].startswith('--machine=') and 'is-active' in args:
    print('active')   # (the console runs, as the owner's service manager says)
elif args[:1] in (['start'], ['try-reload-or-restart'], ['restart'], ['daemon-reload'], ['try-restart']) \
        or (args[:1] and args[0].startswith('--machine=') and args[1:2] == ['--user']):
    pass
elif args[:4] == ['show', '--user', '--property=ExecStart', '--value'] and len(args) == 5:
    try:
        with open(os.path.join(R, 'standin', 'user-units')) as f:
            units = dict(line.split(None, 1) for line in f.read().splitlines() if line.strip())
    except OSError:
        units = {}
    if args[4] in units:
        print(f'{{ path={units[args[4]].strip()} ; argv[]={units[args[4]].strip()} ; ignore_errors=no }}')
else:
    sys.stderr.write('systemctl: the stand-in does not answer this\n')
    sys.exit(1)
