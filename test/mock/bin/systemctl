#!/usr/bin/env python3
# Stand-in systemctl for rehearsals of the root helper (deploy/spark-console-root; test/root-helper.test.mjs). Outside a
# rehearsal (SPARK_CONSOLE_REHEARSAL naming its folder) it fails. Every call is one JSON line in <rehearsal>/calls.log.
# It answers the helper's four questions and nothing else: the running systemd's version (from
# <rehearsal>/standin/systemd-version, else 255.4-1ubuntu8.4), a unit's main process (4242; 0 with
# <rehearsal>/standin/no-pid), whether a unit is active (yes; no with <rehearsal>/standin/target-dead), and stop (does
# nothing). And the one-time command's read of a unit's program (show --user), from <rehearsal>/standin/user-units,
# one per line: "<unit> <program>" (nothing without it). The lock-out net's: a unit's ActiveState (a net's timer is
# active while <rehearsal>/standin/timers/<unit> is there, as the stand-in systemd-run leaves it; any other unit is
# inactive, but one a test marks running with <rehearsal>/standin/active/<unit>, and nothing at all for one it marks
# with <rehearsal>/standin/silent/<unit>); stop of a net's timer takes that away
# (it fails with <rehearsal>/standin/timer-stop-fails); stop and kill of a unit end it; and try-reload-or-restart,
# restart, daemon-reload and try-restart, the user manager's too, which do nothing. A way-in unit (A13b) a test
# writes as <rehearsal>/standin/units/<unit> ("<active> <file>", as "active enabled") is shown by show
# --property=ActiveState,UnitFileState,LoadState, and start, stop, restart, enable, disable, mask and unmask change it
# (--no-block too); its LoadState is "masked" while its file is, as systemd says; one with no such file is not-found.
# A look's or a change's unit (sw-look-, sw-run-) is active
# while the stand-in systemd-run runs it (to show ActiveState, and stop ends it there, only with
# <rehearsal>/standin/stop-ends). Real systemd does what stop-ends does: ActiveState is active while the unit runs, and
# stop ends it (SIGTERM, then SIGKILL past TimeoutStopSec) and waits until it is gone. Without the knob a stop of a
# running run unit only leaves <rehearsal>/standin/stopped/<unit>, and root-helper.test's disk-floor test relies on
# that: its command sees the mark and exits 9 by itself, where on a Spark the helper's stop would end it (no exit 9).
# Called with no rehearsal named, on a stand-in Spark with ~/.rehearsal, it answers from that one.
# <rehearsal>/standin/holds/<unit>: a unit marked running (standin/active) that a stop does not end at once: "<n>", the
# next n answers of its ActiveState say active, then it is gone; "never", SIGKILL does not end it either.
# A unit written "<active> <file> links" takes its file state from its links in the rehearsal's /etc/systemd/system, as
# systemd's does (A-15): masked while <unit> there is a link to /dev/null, enabled while a *.wants/<unit> link is there,
# else disabled; and enable, disable, mask and unmask make and take away those links.
import json, os, sys

R = os.environ.get('SPARK_CONSOLE_REHEARSAL', '')
# (a stand-in Spark's own rehearsal, ~/.rehearsal, when the caller names none: the console asking it a question)
if not R and os.path.isdir(os.path.join(os.environ.get('HOME', '/nonexistent'), '.rehearsal')):
    R = os.path.realpath(os.path.join(os.environ['HOME'], '.rehearsal'))
if not R.startswith('/') or not os.path.isdir(R):
    sys.stderr.write('systemctl: this stand-in only answers inside a rehearsal of the root helper\n')
    sys.exit(1)
args = sys.argv[1:]
with open(os.path.join(R, 'calls.log'), 'a') as f:
    f.write(json.dumps(['systemctl'] + args) + '\n')
args = [a for a in args if a not in ('--', '--no-block')]
units = os.path.join(R, 'standin', 'units')


def unit(name):
    try:
        with open(os.path.join(units, name)) as f:
            return f.read().split()
    except OSError:
        return None


SYSTEM = os.path.join(R, 'etc', 'systemd', 'system')


def links_state(name):   # a unit's file state as its links say
    at = os.path.join(SYSTEM, name)
    if os.path.islink(at) and os.readlink(at) == '/dev/null':
        return 'masked'
    try:
        wants = [d for d in os.listdir(SYSTEM) if d.endswith('.wants') and os.path.islink(os.path.join(SYSTEM, d, name))]
    except OSError:
        wants = []
    return 'enabled' if wants else 'disabled'


def file_of(u, name):
    return links_state(name) if len(u) > 2 and u[2] == 'links' else u[1]


def set_links(name, verb):   # what enable, disable, mask and unmask do to a unit's links, as systemctl does
    at, want = os.path.join(SYSTEM, name), os.path.join(SYSTEM, 'multi-user.target.wants', name)
    if verb == 'enable' and not os.path.lexists(want):
        os.makedirs(os.path.dirname(want), exist_ok=True)
        os.symlink(f'/usr/lib/systemd/system/{name}', want)
    elif verb == 'disable':
        for d in [d for d in os.listdir(SYSTEM) if d.endswith('.wants')] if os.path.isdir(SYSTEM) else []:
            if os.path.islink(os.path.join(SYSTEM, d, name)):
                os.unlink(os.path.join(SYSTEM, d, name))
    elif verb == 'mask' and not os.path.lexists(at):
        os.makedirs(SYSTEM, exist_ok=True)
        os.symlink('/dev/null', at)
    elif verb == 'unmask' and os.path.islink(at) and os.readlink(at) == '/dev/null':
        os.unlink(at)


def set_unit(name, active=None, file=None):
    u = unit(name)
    if u is None:
        return
    links = len(u) > 2 and u[2] == 'links'
    with open(os.path.join(units, name), 'w') as f:
        f.write(f'{active or u[0]} {(links_state(name) if links else file) or u[1]}' + (' links' if links else '') + '\n')
timers, running = os.path.join(R, 'standin', 'timers'), os.path.join(R, 'standin', 'active')


live = os.path.join(R, 'standin', 'live')
# <rehearsal>/standin/stop-ends (test/long.test.mjs): a look's or a change's unit the stand-in systemd-run runs now is
# active to show ActiveState, and stop ends it. Without it neither does, as the helper's own tests expect.
stop_ends = os.path.exists(os.path.join(R, 'standin', 'stop-ends'))


def stop_live(name):
    # A look's or a change's unit the stand-in systemd-run runs now: ended with everything it started (its stand-in gets
    # SIGTERM), waited for until it is gone, as systemctl stop waits.
    f = os.path.join(live, name.removesuffix('.service'))
    if not stop_ends or not name.startswith(('sw-run-', 'sw-look-')) or not os.path.exists(f):
        return
    import signal, time
    try:
        with open(f) as h:
            os.kill(int(h.read().strip()), signal.SIGTERM)
    except (OSError, ValueError):
        return
    for _ in range(100):
        if not os.path.exists(f):
            return
        time.sleep(0.1)


def ended(unit):
    try:
        os.unlink(os.path.join(running, unit))
    except FileNotFoundError:
        pass


def hold(unit):   # what standin/holds/<unit> says, or None
    try:
        with open(os.path.join(R, 'standin', 'holds', unit)) as f:
            return f.read().strip()
    except OSError:
        return None
try:
    with open(os.path.join(R, 'standin', 'systemd-version')) as f:
        version = f.read().strip()
except OSError:
    version = '255.4-1ubuntu8.4'
if args == ['show', '--property=Version', '--value']:
    print(version)
elif args[:3] == ['show', '--property=MainPID', '--value'] and len(args) == 4:
    print(0 if os.path.exists(os.path.join(R, 'standin', 'no-pid')) else 4242)
elif args[:2] == ['is-active', '--quiet'] and len(args) == 3 and args[2].startswith(('sw-run-', 'sw-look-', 'sw-root-')):
    sys.exit(0 if os.path.exists(os.path.join(R, 'standin', 'live', args[2].removesuffix('.service'))) else 3)
elif args[:2] == ['is-active', '--quiet'] and len(args) == 3:
    sys.exit(3 if os.path.exists(os.path.join(R, 'standin', 'target-dead')) else 0)
elif args[:2] == ['show', '--property=ActiveState,UnitFileState,LoadState'] and len(args) == 3:
    u = unit(args[2])
    print(f"ActiveState={u[0]}\nUnitFileState={file_of(u, args[2])}\nLoadState={'masked' if file_of(u, args[2]) == 'masked' else 'loaded'}" if u
          else 'ActiveState=inactive\nUnitFileState=\nLoadState=not-found')   # (as systemd: a masked unit's LoadState is masked)
elif args[:3] == ['show', '--property=ActiveState', '--value'] and len(args) == 4 \
        and os.path.exists(os.path.join(R, 'standin', 'silent', args[3])):
    pass   # (systemd gave no answer for this unit)
elif args[:3] == ['show', '--property=ActiveState', '--value'] and len(args) == 4 and hold(args[3]) not in (None, 'never') \
        and os.path.exists(os.path.join(running, args[3])):
    n = int(hold(args[3]) or 0)
    if n > 0:
        with open(os.path.join(R, 'standin', 'holds', args[3]), 'w') as f:
            f.write(str(n - 1))
        print('active')
    else:
        os.unlink(os.path.join(R, 'standin', 'holds', args[3]))
        ended(args[3])
        print('inactive')
elif args[:3] == ['show', '--property=ActiveState', '--value'] and len(args) == 4:
    print('active' if os.path.exists(os.path.join(timers, args[3])) or os.path.exists(os.path.join(running, args[3]))
          or (stop_ends and args[3].startswith(('sw-run-', 'sw-look-')) and os.path.exists(os.path.join(live, args[3].removesuffix('.service'))))
          or (unit(args[3]) or ['inactive'])[0] == 'active' else 'inactive')
elif args[:1] in (['start'], ['restart']) and len(args) == 2 and unit(args[1]):
    set_unit(args[1], active='active')
elif args[:1] in (['enable'], ['disable'], ['mask'], ['unmask']) and len(args) == 2:
    if (unit(args[1]) or [])[2:3] == ['links']:
        set_links(args[1], args[0])
    set_unit(args[1], file={'enable': 'enabled', 'disable': 'disabled', 'mask': 'masked', 'unmask': 'disabled'}[args[0]])
elif args[:1] == ['stop'] and len(args) == 2 and args[1].startswith('sw-guard-'):
    if os.path.exists(os.path.join(R, 'standin', 'timer-stop-fails')):
        sys.stderr.write('Failed to stop: Access denied\n')
        sys.exit(1)
    try:
        os.unlink(os.path.join(timers, args[1]))
    except FileNotFoundError:
        pass
elif args[:1] == ['stop'] and len(args) == 2:
    if hold(args[1]) is None:
        ended(args[1])
    set_unit(args[1], active='inactive')
    stop_live(args[1])
    if args[1].startswith(('sw-run-', 'sw-root-')):   # (a command can see it was ended: <rehearsal>/standin/stopped/<unit>)
        os.makedirs(os.path.join(R, 'standin', 'stopped'), exist_ok=True)
        open(os.path.join(R, 'standin', 'stopped', args[1]), 'w').close()
elif args[:1] == ['kill']:
    if hold(args[-1]) != 'never':
        ended(args[-1])
elif args[:1] and args[0].startswith('--machine=') and 'is-active' in args:
    print('active')   # (the console runs, as the owner's service manager says)
elif args[:1] in (['start'], ['try-reload-or-restart'], ['restart'], ['daemon-reload'], ['try-restart']) \
        or (args[:1] and args[0].startswith('--machine=') and args[1:2] == ['--user']):
    pass
elif args[:4] == ['show', '--user', '--property=ExecStart', '--value'] and len(args) == 5:
    try:
        with open(os.path.join(R, 'standin', 'user-units')) as f:
            units = dict(line.split(None, 1) for line in f.read().splitlines() if line.strip())
    except OSError:
        units = {}
    if args[4] in units:
        print(f'{{ path={units[args[4]].strip()} ; argv[]={units[args[4]].strip()} ; ignore_errors=no }}')
else:
    sys.stderr.write('systemctl: the stand-in does not answer this\n')
    sys.exit(1)
