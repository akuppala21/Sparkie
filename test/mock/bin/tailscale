#!/bin/bash
# Stand-in tailscale: `tailscale ip -4` on any test Spark is this machine's loopback, so the addresses Spark Console
# builds for its models (http://<tailscale ip>:<serve port>/v1) reach the stand-in serve port, not a tailnet that
# isn't there. (The Sparks' own tailnet addresses, for refusing requests from them, come from access.json.) A test can
# give one Spark another address with ~/.mock/tsip (an app then also publishes its port there).
# `tailscale serve status --json` (Spark Console's own route check) answers with $MOCK_DIR/serve.json, or with nothing
# loaded ({}), as tailscaled does right after a boot.
case "$1" in
  ip) cat "$HOME/.mock/tsip" 2>/dev/null || echo 127.0.0.1 ;;
  serve) cat "$MOCK_DIR/serve.json" 2>/dev/null || echo '{}' ;;
esac
