#!/bin/bash
# Stand-in sudo for the power-off tests (21-power.mjs): only `sudo -n` (never a password) with the two commands
# deploy/power-setup.sh lets the owner's account run, and `sudo -n -l <command>` to ask whether it may. ~/.mock/no-sudo:
# that rule isn't set up on this Spark, so sudo asks for a password (refused, as sudo -n does). `systemctl poweroff`
# shuts this stand-in Spark down: every running container exits as a clean shutdown stops it, and the Spark goes dark
# (its name joins the stand-in fleet's offline file, which the stand-in plug reads for its watts). ~/.mock/poweroff-hangs:
# the shutdown is accepted but the Spark keeps answering. ~/.mock/poweroff-refused: asking (-l) says yes, but the shutdown
# itself asks for a password (a rule changed in between). Never runs anything for real.
# The root helper's rehearsal (test/rehearsal.mjs): a Spark whose ~/.rehearsal holds a made-up root with the real
# helper runs it, through sudo -n only and only while the rehearsal has its sudo line, as sudo would run it for root
# (SUDO_UID and SUDO_USER set; the rehearsal's folder named, so the helper reads every system path under it).
# ~/.mock/sudo-drops: the helper runs, but the connection drops at once, as ssh's does (255, nothing said); with
# "first-line" in it, the first line the helper prints is passed on before the drop. The helper runs as this stand-in's
# child, never in its place: a caller that ends this call (the console's own time-out) ends the connection, not the
# helper, as on a Spark, where ssh's end doesn't end the call there.
M="$HOME/.mock"; spark=$(basename "$HOME")
[ "$1" = -n ] || { echo "sudo: the stand-in only answers sudo -n" >&2; exit 1; }
shift
R="$HOME/.rehearsal"
if [ "$1" = "$R/usr/local/sbin/spark-console-root" ]; then
  [ -f "$R/etc/sudoers.d/spark-console-root" ] || { echo "sudo: a password is required" >&2; exit 1; }
  shift; R=$(realpath "$R")
  set -- env SUDO_UID=1000 SUDO_USER=owner SUDO_GID=1000 SPARK_CONSOLE_REHEARSAL="$R" "$R/usr/local/sbin/spark-console-root" "$@"
  if [ -f "$M/sudo-drops" ]; then
    out=$(mktemp); "$@" </dev/null >"$out" 2>&1 &
    if grep -qx first-line "$M/sudo-drops"; then
      for _ in $(seq 200); do [ -n "$(head -n 1 "$out")" ] && break; sleep 0.1; done
      head -n 1 "$out"
    fi
    exit 255
  fi
  "$@"; exit $?
fi
list=0
[ "$1" = -l ] && { list=1; shift; }
if [ -f "$M/no-sudo" ]; then echo "sudo: a password is required" >&2; exit 1; fi
case "$*" in
  "/usr/bin/systemctl stop nvidia-persistenced")
    [ $list = 1 ] && echo "$*"
    exit 0 ;;
  "/usr/bin/systemctl poweroff")
    [ $list = 1 ] && { echo "$*"; exit 0; }
    if [ -f "$M/poweroff-refused" ]; then echo "sudo: a password is required" >&2; exit 1; fi
    [ -f "$M/poweroff-hangs" ] && exit 0
    if [ -f "$M/containers" ]; then
      sed 's/^\([^|]*\)|running|[^|]*|/\1|exited|Exited (0) just now|/' "$M/containers" > "$M/c.tmp" && mv "$M/c.tmp" "$M/containers"
    fi
    rm -f "$M"/up-*
    [ -n "$SPARK_CONSOLE_OFFLINE_FILE" ] && printf '%s\n' "$spark" >> "$SPARK_CONSOLE_OFFLINE_FILE"
    exit 0 ;;
  *) echo "Sorry, user ${USER:-you} is not allowed to execute '$*' as root on $spark." >&2; exit 1 ;;
esac
