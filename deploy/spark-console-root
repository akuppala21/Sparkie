        tries += [f'{mine}/cgroup.procs'] + sorted(glob.glob(f'{mine}/*/cgroup.freeze'))[:8]
    return [p[len('/sys/fs/cgroup'):] for p in tries if os.access(p, os.W_OK)][:4]


def a12(c):  # something left behind: a program put in the background, looked for from outside afterwards
    mark = f'{ID}-{c.mode}-{c.how}'
    subprocess.Popen(['sleep', '300'], env=dict(CLEAN, SPARK_PROOF_LEFT=mark), stdin=DEVNULL, stdout=DEVNULL,
                     stderr=DEVNULL, start_new_session=True)
    return [mark]


def guard_of(c):   # the guard the helper made for this wall's attempts
    return f"{ID[:38]}n{'l' if c.mode == 'look' else 'r'}"


def a15(c):  # stopping or changing the net's timer (looked at again from outside afterwards)
    g, got = guard_of(c), []
    for cmd in (['systemctl', 'stop', f'sw-guard-{g}.timer'], ['systemctl', 'kill', f'sw-guard-{g}.service'],
                ['systemd-run', f'--unit=sw-guard-{g}x', '--on-active=1', 'true']):
        if quiet(cmd):
            got.append(' '.join(cmd[:2]))
    return got


def a16(c):  # writing the net's copies or restore.sh: changing one, or adding a file beside them
    g, got = guard_of(c), []
    for name, flags in (('restore.sh', os.O_APPEND), ('guard.py', os.O_APPEND), ('manifest.json', os.O_APPEND),
                        (f'added-{c.how}', os.O_CREAT | os.O_EXCL)):
        try:
            os.close(os.open(f'{GUARD}/{g}/{name}', os.O_WRONLY | os.O_NOFOLLOW | flags, 0o600))
            got.append(name)
        except OSError:
            pass
    return got


def a17(c):  # taking away the net's pending mark
    try:
        os.unlink(f'{GUARD}/{guard_of(c)}/pending')
        return ['pending']
    except OSError:
        return []


def a18(c):  # making keep count (or putting back): through the helper, or by writing its mark
    g, got = guard_of(c), []
    if quiet(['sudo', '-n', HELPER, 'keep', '--id', g]):
        got.append('sudo -n the helper keep')
    if quiet(['sudo', '-n', HELPER, 'putback', '--id', g]):
        got.append('sudo -n the helper putback')
    if quiet([HELPER, 'keep', '--id', g]):
        got.append('the helper keep')
    try:
        os.close(os.open(f'{GUARD}/{g}/kept', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600))
        got.append('wrote kept')
    except OSError:
        pass
    return got


ATTEMPTS = {1: a1, 2: a2, 3: a3, 4: a4, 5: a5, 6: a6, 7: a7, 8: a8, 9: a9, 10: a10, 11: a11, 12: a12, 14: a14,
            15: a15, 16: a16, 17: a17, 18: a18, 19: a19, 20: a20, 21: a21, 22: a22, 23: a23, 24: a24, 25: a25, 26: a26,
            27: a27, 28: a28, 29: a29, 30: a30, 31: a31}


def what(hits, n=0):
    return ', '.join(hits)[:200] if hits else REASONS.get(n, '-')


def attempts(mode, nums):
    for n in nums:
        if mode == 'outside':
            try:
                hits = ATTEMPTS[n](Ctx(mode, 'outside'))
                out('P', n, 'outside', 'works' if hits else 'not-there', what(hits, n))
            except Exception as e:
                out('P', n, 'outside', 'not-there', type(e).__name__)
            continue
        for how in ('direct', 'child'):
            try:
                if how == 'direct':
                    hits = ATTEMPTS[n](Ctx(mode, how))
                else:
                    r = subprocess.run([sys.executable, '-I', '-S', os.path.abspath(__file__), 'one', mode, str(n)],
                                       stdin=DEVNULL, stdout=subprocess.PIPE, stderr=DEVNULL, timeout=50)
                    hits = json.loads(r.stdout.decode().strip().splitlines()[-1])
            except Exception as e:
                out('P', n, how, 'failed', type(e).__name__)
                continue
            word = 'left' if (n, mode) in LEFT else ('through' if hits else 'blocked')
            out('P', n, how, word, what(hits))


def prep():
    os.umask(0o077)
    made = not os.path.lexists(SHARE)
    os.makedirs(SHARE, exist_ok=True)
    for old in glob.glob(f'{HOME}/.sparkie-proof-*') + glob.glob(f'{HOME}/.cache/.sparkie-proof-*') + glob.glob(f'{SHARE}/proof-*') \
            + glob.glob(f'{JOBS}/sparkie-proof-*'):
        if os.path.islink(old):
            os.unlink(old)
        else:
            shutil.rmtree(old, ignore_errors=True)
    os.makedirs(os.path.dirname(S), exist_ok=True)
    for d in (S, H, HELD, P):
        os.mkdir(d, 0o700)
    os.makedirs(JOB, 0o700)
    write(f'{H}/key', KEY)
    for w in ('look', 'run'):
        write(f'{H}/target-{w}', b'unchanged')
        write(f'{P}/target-{w}', b'unchanged')
        os.symlink(f'{H}/target-{w}', f'{S}/link-{w}')
        os.symlink(f'{P}/target-{w}', f'{S}/ro-{w}')
    os.symlink(f'{H}/key', f'{S}/key-link')
    for i, (_, path) in enumerate(SOCKETS):
        os.symlink(path, f'{S}/sock-{i}')
    own = None   # this Spark's own first address, as hostname -I lists them (no connection is made)
    try:
        listed = subprocess.run(['hostname', '-I'], stdin=DEVNULL, stdout=subprocess.PIPE, stderr=DEVNULL, env=CLEAN,
                                timeout=10).stdout.decode().split()
        own = next((a for a in listed if re.fullmatch(r'\d+\.\d+\.\d+\.\d+', a) and not a.startswith('127.')), None)
    except (OSError, subprocess.SubprocessError):
        pass
    handle = handle_of(f'{H}/key')
    with open(f'{S}/fixtures.json', 'w') as f:
        json.dump({'made_share': made, 'handle': handle, 'own': own, 'held': os.stat(HELD).st_ino, 'job': os.stat(JOB).st_ino}, f)
    # Without a handle the look wall's file-handle filter would be tried by nothing.
    out('S ok' if handle else 'S failed: no file handle for the proof key')


def setup():
    os.umask(0)
    stay, seen = [], set()
    with open('/proc/self/mountinfo') as f:
        for line in f:
            left, _, right = line.partition(' - ')
            fields, kind = left.split(), right.split()
            if len(fields) < 6 or not kind or kind[0] not in DISKS or 'ro' in fields[5].split(','):
                continue
            point = re.sub(r'\\([0-7]{3})', lambda m: chr(int(m.group(1), 8)), fields[4])
            if point in seen:
                continue
            seen.add(point)
            for old in glob.glob(os.path.join(glob.escape(point), '.spark-console-proof-*')):
                remove_dir(old)
            d = os.path.join(point, f'.spark-console-proof-{ID}')
            try:
                os.mkdir(d, 0o1777)
                stay.append(d)
            except OSError:
                pass
    fd = os.open(os.path.join(HERE, 'stay'), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, 'wb') as f:
        f.write(b'\0'.join(os.fsencode(d) for d in stay))
    # Without a folder on a disk, the look wall's read-only disks would be tried by nothing.
    out('S ok' if stay else 'S failed: no folder could be made on any disk')


def target():
    s = socket.socket()
    s.bind(('127.0.0.1', 0))
    s.listen(16)
    s.settimeout(1)
    # (a terminal of its own, held open while it runs: attempt 30 opens it by its name; and its own control group, which
    # systemd handed to the owner: attempt 31 asks to write it. Written before the port, which the attempts wait for)
    try:
        pty = os.openpty()
        write(f'{S}/pty.new', os.ttyname(pty[1]).encode())
        os.replace(f'{S}/pty.new', f'{S}/pty')
    except OSError:
        pass
    try:
        with open('/proc/self/cgroup') as f:
            write(f'{S}/cgroup.new', f.read().strip().split('::', 1)[1].encode())
        os.replace(f'{S}/cgroup.new', f'{S}/cgroup')
    except (OSError, IndexError):
        pass
    write(f'{S}/port.new', str(s.getsockname()[1]).encode())
    os.replace(f'{S}/port.new', f'{S}/port')
    end = time.monotonic() + 300
    while time.monotonic() < end:
        try:
            s.accept()[0].close()
        except OSError:
            pass


def post():
    for w in ('look', 'run'):
        changed = []
        for t in (f'{H}/target-{w}', f'{P}/target-{w}'):
            try:
                with open(t, 'rb') as f:
                    if f.read() != b'unchanged':
                        changed.append(os.path.basename(os.path.dirname(t)) + '/' + os.path.basename(t))
            except OSError:
                changed.append(os.path.basename(t) + ' is gone')
        out('V', 1, w, 'through' if changed else 'blocked', what(changed))
    made = glob.glob(f'{P}/.spark-console-proof-{ID}-run-*')
    out('V', 5, 'run', 'through' if made else 'blocked', 'a file in the read-only folder' if made else '-')
    try:
        with open(f'{S}/fixtures.json') as f:
            fx = json.load(f)
    except (OSError, ValueError):
        fx = {}
    try:
        same = os.stat(HELD).st_ino == fx.get('held')
    except OSError:
        same = False
    moved = glob.glob(f'{HELD}-moved-*')
    out('V', 14, 'run', 'blocked' if same and not moved else 'through', 'the folder above is the same one' if same and not moved
        else 'the folder above was moved or replaced')
    try:
        st = os.lstat(JOB)
        job = stat.S_ISDIR(st.st_mode) and st.st_ino == fx.get('job')
    except OSError:
        job = False
    swapped = glob.glob(f'{JOB}-moved-*')
    out('V', 19, 'run', 'blocked' if job and not swapped else 'through', "the job's folder is the same one" if job and not swapped
        else "the job's folder was moved or replaced")
    for old in [JOB] + swapped:
        if os.path.islink(old):
            os.unlink(old)
        else:
            shutil.rmtree(old, ignore_errors=True)
    made_share = fx.get('made_share')
    for d in (S, H):
        shutil.rmtree(d, ignore_errors=True)
    if made_share:
        try:
            os.rmdir(SHARE)
        except OSError:
            pass


def after():
    stayed, seen = [], 0
    for d in lines_of('stay'):
        if not d.endswith(f'/.spark-console-proof-{ID}'):
            continue
        try:
            names = os.listdir(d)
            if any(n.startswith(f'.spark-console-proof-{ID}-look') for n in names):
                stayed.append(os.path.dirname(d) or '/')
            seen += f'.spark-console-proof-{ID}-outside' in names
        except OSError:
            pass
        remove_dir(d)
    out('V', 5, 'outside', 'works' if seen else 'not-there', f'saw {seen} written outside' if seen else 'saw nothing written outside')
    for d in SHARED:
        for how in ('direct', 'child'):
            q = f'{d}/.spark-console-proof-{ID}-look-{how}'
            if os.path.lexists(q):
                stayed.append(d)
                try:
                    os.unlink(q)
                except OSError:
                    pass
    out('V', 5, 'look', 'through' if stayed else 'blocked', what(sorted(set(stayed))))
    left, control = {'look': 0, 'run': 0}, 0
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            with open(f'/proc/{pid}/environ', 'rb') as f:
                env = f.read()
        except OSError:
            continue
        control += b'SPARK_PROOF_MARK=' + ID.encode() in env   # the proof's own program: the scan must see it
        for w in left:
            if f'SPARK_PROOF_LEFT={ID}-{w}-'.encode() in env:
                left[w] += 1
                try:
                    os.kill(int(pid), signal.SIGKILL)
                except OSError:
                    pass
    out('V', 12, 'outside', 'works' if control else 'not-there', 'saw the program outside the walls' if control else 'saw no program outside the walls')
    for w in ('look', 'run'):
        out('V', 12, w, 'through' if left[w] else 'blocked', f'{left[w]} still running' if left[w] else '-')
    # 23 and 24 (the run wall): nothing left in the real /dev/shm or IPC; the home's own mode as it was (put back if not).
    left23 = []
    for how in ('direct', 'child'):
        q = f'/dev/shm/.spark-console-proof-{ID}-run-{how}'
        if os.path.lexists(q):
            left23.append(q)
            try:
                os.unlink(q)
            except OSError:
                pass
        try:
            libc = ctypes.CDLL(None, use_errno=True)
            sid = libc.shmget(shm_key(how), 0, 0)
            if sid >= 0:
                left23.append(f'a SysV segment ({how})')
                libc.shmctl(sid, 0, None)
        except (OSError, AttributeError):
            pass
    out('V', 23, 'run', 'through' if left23 else 'blocked', what(left23))
    seen23 = []   # (the control: what the attempt outside left must be seen, and goes)
    q = f'/dev/shm/.spark-console-proof-{ID}-outside'
    if os.path.lexists(q):
        seen23.append('/dev/shm')
        try:
            os.unlink(q)
        except OSError:
            pass
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        sid = libc.shmget(shm_key('outside'), 0, 0)
        if sid >= 0:
            seen23.append('IPC')
            libc.shmctl(sid, 0, None)
    except (OSError, AttributeError):
        pass
    out('V', 23, 'outside', 'works' if len(seen23) == 2 else 'not-there', f'saw what was left in {" and ".join(seen23)}' if seen23 else 'saw nothing left outside')
    try:
        with open(os.path.join(HERE, 'home-mode')) as f:
            home_was = int(f.read().strip(), 8)
        home_now = stat.S_IMODE(os.stat(HOME).st_mode)
        if home_was is not None and home_now != home_was:
            os.chmod(HOME, home_was)
        out('V', 24, 'run', 'blocked' if home_was is None or home_now == home_was else 'through', f'{home_now:o}')
    except (OSError, ValueError):
        out('V', 24, 'run', 'through', "the home's mode could not be read")
    # The net's guards (15 to 18): each wall's still waiting, its restore.sh as written, nothing added, pending there,
    # never kept. A guard the helper could not make is not named, and its attempts are then not reported.
    try:
        with open(os.path.join(HERE, 'guards')) as f:
            guards = [line.split() for line in f.read().splitlines() if len(line.split()) == 3]
    except OSError:
        guards = []
    mine = {'restore.sh', 'guard.py', 'unit', 'root', 'owner', 'paths', 'at', 'manifest.json', 'pending', 'files', 'lock', 'proof'}
    for w, g, sha in guards:
        wall, d = ('look' if w == 'l' else 'run'), f'{GUARD}/{g}'
        try:
            state = subprocess.run(['systemctl', 'show', '--property=ActiveState', '--value', f'sw-guard-{g}.timer'],
                                   stdin=DEVNULL, stdout=subprocess.PIPE, stderr=DEVNULL, env=CLEAN, timeout=10).stdout.decode().strip()
        except (OSError, subprocess.SubprocessError):
            state = 'unknown'
        try:
            with open(f'{d}/restore.sh', 'rb') as f:
                same = hashlib.sha256(f.read()).hexdigest() == sha
            added = sorted(set(os.listdir(d)) - mine)
        except OSError:
            same, added = False, ['its folder could not be read']
        out('V', 15, wall, 'blocked' if state == 'active' else 'through', f'its timer is {state}')
        out('V', 16, wall, 'blocked' if same and not added else 'through', what((['restore.sh changed'] if not same else []) + added))
        out('V', 17, wall, 'blocked' if os.path.exists(f'{d}/pending') else 'through', '-' if os.path.exists(f'{d}/pending') else 'pending is gone')
        out('V', 18, wall, 'blocked' if not os.path.lexists(f'{d}/kept') else 'through', '-' if not os.path.lexists(f'{d}/kept') else 'kept is there')


if __name__ == '__main__':
    mode = sys.argv[1]
    if mode in ('outside', 'look', 'run', 'home'):
        attempts(mode, [int(n) for n in sys.argv[2:]])
    elif mode == 'one':
        print(json.dumps(ATTEMPTS[int(sys.argv[3])](Ctx(sys.argv[2], 'child'))), flush=True)
    else:
        {'prep': prep, 'setup': setup, 'target': target, 'post': post, 'after': after}[mode]()
PROOF
}

main() {
  init
  parse "$@"
  case "$VERB" in
    check|prove|look|run|root|keep|putback|stop|state) ;;
    *) refuse "no such verb: check, prove, look, run, keep, putback, stop, state or root" ;;
  esac
  caller
  case "$VERB" in
    check) only_id; do_check ;;
    prove) only_id; do_prove ;;
    look|run|root) do_unit ;;
    keep) do_keep ;;
    putback) do_putback ;;
    state) do_state ;;
    stop) do_stop ;;
  esac
}

# The whole file is read before anything runs (bash reads a script as it goes).
main "$@"
exit 125
