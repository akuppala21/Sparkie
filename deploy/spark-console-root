    try:
        os.makedirs(P)
        write(f'{P}/target-run', b'changed')
    except OSError:
        pass
    return [f'renamed it ({c.how})']


def a19(c):  # swapping a job's own output folder for a link (the console mounts it at /out by its name)
    if c.mode == 'outside':
        return ['may rename it'] if os.access(JOBS, os.W_OK | os.X_OK) and os.path.isdir(JOB) else []
    try:
        os.rename(JOB, f'{JOB}-moved-{c.how}')
    except OSError:
        return []
    try:
        os.symlink(HOME, JOB)
    except OSError:
        pass
    return [f'renamed it ({c.how})']


def a20(c):  # ending a unit through the helper's stop: the owner's sudo line reaches it outside the walls, nothing inside
    got = []
    if quiet(['sudo', '-n', HELPER, 'stop', '--id', ID]):
        got.append('sudo -n the helper stop')
    if c.mode != 'outside' and quiet([HELPER, 'stop', '--id', ID]):
        got.append('the helper stop')
    return got


def cgroup_file(name):   # this unit's own cgroup file, or None
    try:
        with open('/proc/self/cgroup') as f:
            path = f.read().strip().split('::', 1)[1]
        with open(f'/sys/fs/cgroup{path}/{name}') as f:
            return f.read().strip()
    except (OSError, IndexError):
        return None


def a21(c):  # more memory, swap or share than given: the 2G of --memory, no swap, a weight of 20 (a file not there is no
    got = []  # answer for the swap and the weights: their controller may be off; memory's must be there)
    mem = cgroup_file('memory.max')
    if mem != str(2 << 30):
        got.append(f'memory.max is {mem}' if mem else 'its memory cap could not be read')
    for name, want in (('memory.swap.max', '0'), ('cpu.weight', '20')):
        v = cgroup_file(name)
        if v is not None and v != want:
            got.append(f'{name} is {v}')
    io = cgroup_file('io.weight')
    if io is not None and 'default 20' not in io:
        got.append(f'io.weight is {io}')
    return got


def a22(c):  # a connection to this Spark's own address (its ssh) or to Tailscale's own (the tailnet), from the run wall
    got = []
    own = c.fx.get('own')
    for addr, port in ([(own, 22)] if own else []) + [('100.100.100.100', 53)]:
        if tcp(addr, port):
            got.append(f'{addr}:{port}')
    return got


def shm_key(how):
    return int(hashlib.sha256(f'{ID}-{how}'.encode()).hexdigest()[:7], 16)


def a23(c):  # a file left in /dev/shm and a SysV segment left in IPC: both looked for from outside afterwards (outside,
    left = []  # the same, which the check afterwards must see: the control)
    tag = 'outside' if c.mode == 'outside' else f'run-{c.how}'
    try:
        write(f'/dev/shm/.spark-console-proof-{ID}-{tag}', b'left')
        left.append('/dev/shm')
    except OSError:
        pass
    try:
        if ctypes.CDLL(None, use_errno=True).shmget(shm_key('outside' if c.mode == 'outside' else c.how), 4096, 0o1600) >= 0:
            left.append('IPC')
    except (OSError, AttributeError):
        pass
    return left if c.mode == 'outside' and len(left) == 2 else []


def a24(c):  # the home's own mode: opened to all (sshd would then refuse the owner's key); looked at afterwards
    if c.mode == 'outside':   # (by its rights only: the home is the owner's to change. Never done outside)
        return ['may change its mode'] if os.stat(HOME).st_uid == UID else []
    try:
        os.chmod(HOME, 0o777)
    except OSError:
        pass
    return []


def a25(c):  # the owner's start files, read (a token set there)
    got = []
    for name in ('.bashrc', '.profile'):
        try:
            with open(f'{HOME}/{name}', 'rb') as f:
                f.read(1)
            got.append(name)
        except OSError:
            pass
    return got


def a26(c):  # a name made at the top of the home, and in a dot folder (outside: made and taken away again)
    got = []
    for p in (f'{HOME}/.sparkie-proof-{ID}-top-{c.how}', f'{HOME}/.config/.sparkie-proof-{ID}-{c.how}'):
        try:
            os.close(os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600))
            got.append(p.replace(HOME, '~', 1))
            os.unlink(p)
        except OSError:
            pass
    return got


def a27(c):  # a write where a change may write: ~/.cache (the proof's own folder there) and its own /dev/shm must work
    got = []
    for p in (f'{S}/.written-{c.mode}-{c.how}', f'/dev/shm/.spark-console-proof-{ID}-ok-{c.mode}-{c.how}'):
        try:
            write(p, b'ok')
            os.unlink(p)
        except OSError as x:
            got.append(f'{p.replace(HOME, "~", 1)}: {x.strerror}')
    return got


def a28(c):  # with --home, a name made at the top of the home and in ~/.local/bin must work (and is taken away again)
    got = []
    bin_ = f'{HOME}/.local/bin' if os.path.isdir(f'{HOME}/.local/bin') else f'{HOME}/.local'
    for p in (f'{HOME}/.sparkie-proof-{ID}-home-{c.how}', f'{bin_}/.sparkie-proof-{ID}-home-{c.how}'):
        try:
            write(p, b'ok')
            os.unlink(p)
        except OSError as x:
            got.append(f'{p.replace(HOME, "~", 1)}: {x.strerror}')
    return got


def a29(c):  # a write in ~/.ssh (its keys are hidden; what is put back there is read-only)
    try:
        os.close(os.open(f'{HOME}/.ssh/.sparkie-proof-{ID}-{c.how}', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600))
        os.unlink(f'{HOME}/.ssh/.sparkie-proof-{ID}-{c.how}')
        return ['~/.ssh']
    except OSError:
        return []


def a30(c):  # a terminal of this Spark: the one the proof's own program holds (outside, it opens), and inside any at all
    try:              # (opened and closed at once, never read: no keystroke is taken)
        with open(f'{S}/pty') as f:
            mine = [f.read().strip()]
    except OSError:
        mine = []
    got = []
    for d in dict.fromkeys(mine + ([] if c.mode == 'outside' else sorted(glob.glob('/dev/pts/[0-9]*')))):
        for flags in (os.O_RDONLY, os.O_WRONLY):
