main() {
  init
  parse "$@"
  case "$VERB" in
    check|prove|look|run|keep|putback|stop) ;;
    root) refuse "root needs the put-back net, which is not built yet: root is refused on every Spark" ;;
    *) refuse "no such verb: check, prove, look, run, keep, putback, stop or root" ;;
  esac
  caller
  case "$VERB" in
    check) only_id; do_check ;;
    prove) only_id; do_prove ;;
    look|run) do_unit ;;
    keep) do_keep ;;
    putback) do_putback ;;
    stop) do_stop ;;
  esac
}

# The whole file is read before anything runs (bash reads a script as it goes).
main "$@"
exit 125
