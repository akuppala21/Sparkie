def after():
    stayed, seen = [], 0
    for d in lines_of('stay'):
        if not d.endswith(f'/.spark-console-proof-{ID}'):
            continue
        try:
            names = os.listdir(d)
            if any(n.startswith(f'.spark-console-proof-{ID}-look') for n in names):
                stayed.append(os.path.dirname(d) or '/')
            seen += f'.spark-console-proof-{ID}-outside' in names
        except OSError:
            pass
        remove_dir(d)
    out('V', 5, 'outside', 'works' if seen else 'not-there', f'saw {seen} written outside' if seen else 'saw nothing written outside')
    for d in SHARED:
        for how in ('direct', 'child'):
            q = f'{d}/.spark-console-proof-{ID}-look-{how}'
            if os.path.lexists(q):
                stayed.append(d)
                try:
                    os.unlink(q)
                except OSError:
                    pass
    out('V', 5, 'look', 'through' if stayed else 'blocked', what(sorted(set(stayed))))
    left, control = {'look': 0, 'run': 0}, 0
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            with open(f'/proc/{pid}/environ', 'rb') as f:
                env = f.read()
        except OSError:
            continue
        control += b'SPARK_PROOF_MARK=' + ID.encode() in env   # the proof's own program: the scan must see it
        for w in left:
            if f'SPARK_PROOF_LEFT={ID}-{w}-'.encode() in env:
                left[w] += 1
                try:
                    os.kill(int(pid), signal.SIGKILL)
                except OSError:
                    pass
    out('V', 12, 'outside', 'works' if control else 'not-there', 'saw the program outside the walls' if control else 'saw no program outside the walls')
    for w in ('look', 'run'):
        out('V', 12, w, 'through' if left[w] else 'blocked', f'{left[w]} still running' if left[w] else '-')
    # The net's guards (15 to 18): each wall's still waiting, its restore.sh as written, nothing added, pending there,
    # never kept. A guard the helper could not make is not named, and its attempts are then not reported.
    try:
        with open(os.path.join(HERE, 'guards')) as f:
            guards = [line.split() for line in f.read().splitlines() if len(line.split()) == 3]
    except OSError:
        guards = []
    mine = {'restore.sh', 'guard.py', 'unit', 'root', 'owner', 'paths', 'at', 'manifest.json', 'pending', 'files', 'lock', 'proof'}
    for w, g, sha in guards:
        wall, d = ('look' if w == 'l' else 'run'), f'{GUARD}/{g}'
        try:
            state = subprocess.run(['systemctl', 'show', '--property=ActiveState', '--value', f'sw-guard-{g}.timer'],
                                   stdin=DEVNULL, stdout=subprocess.PIPE, stderr=DEVNULL, env=CLEAN, timeout=10).stdout.decode().strip()
        except (OSError, subprocess.SubprocessError):
            state = 'unknown'
        try:
            with open(f'{d}/restore.sh', 'rb') as f:
                same = hashlib.sha256(f.read()).hexdigest() == sha
            added = sorted(set(os.listdir(d)) - mine)
        except OSError:
            same, added = False, ['its folder could not be read']
        out('V', 15, wall, 'blocked' if state == 'active' else 'through', f'its timer is {state}')
        out('V', 16, wall, 'blocked' if same and not added else 'through', what((['restore.sh changed'] if not same else []) + added))
        out('V', 17, wall, 'blocked' if os.path.exists(f'{d}/pending') else 'through', '-' if os.path.exists(f'{d}/pending') else 'pending is gone')
        out('V', 18, wall, 'blocked' if not os.path.lexists(f'{d}/kept') else 'through', '-' if not os.path.lexists(f'{d}/kept') else 'kept is there')


