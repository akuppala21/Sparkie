def a8(c):   # more rights
    got = []
    if quiet(['sudo', '-n', 'true']):
        got.append('sudo -n true')
    if quiet(['sudo', '-n', HELPER, 'check', '--id', ID]):
        got.append('sudo -n the helper')
    if quiet([HELPER, 'check', '--id', ID]):
        got.append('the helper itself')
    if c.mode != 'outside':
        allowed = (1 << 2) if c.mode == 'look' else 0   # CAP_DAC_READ_SEARCH, and only in a look
        with open('/proc/self/status') as f:
            for line in f:
                k, _, v = line.partition(':')
                if k in ('CapInh', 'CapPrm', 'CapEff', 'CapBnd', 'CapAmb') and int(v, 16) & ~allowed:
                    got.append(f'{k} {v.strip()}')
    return got


def a9(c):   # starting something outside the wall
    env = dict(CLEAN, XDG_RUNTIME_DIR=f'/run/user/{UID}', HOME=HOME)
    got = [p for p in (f'/run/user/{UID}/bus', f'/run/user/{UID}/systemd/private', '/run/dbus/system_bus_socket',
                       '/run/systemd/private') if unix(p)]
    if quiet(['systemctl', '--user', 'show-environment'], env):
        got.append('systemctl --user')
    if quiet(['systemd-run', '--user', '--wait', '--quiet', '--collect', 'true'], env):
        got.append('systemd-run --user')
    return got


def a10(c):  # a hidden key file
    got = []
    if readable(f'{H}/key'):
        got.append('by its path')
    if readable(f'{S}/key-link'):
        got.append('through a link')
    if any(readable(p) for p in glob.glob(f'{SHARE}/proof-*/key')):
        got.append('by *')
    if c.mode == 'look' and by_handle(c.fx.get('handle')):
        got.append('by its file handle')
    return got


def a11(c):  # a disk device and the GPU
    try:
        devs = ['/dev/' + n for n in sorted(os.listdir('/sys/class/block'))]
    except OSError:
        devs = []
    devs += GPU + glob.glob('/dev/dri/*')
    if c.mode == 'outside':
        return [d for d in devs if os.path.exists(d)][:4]
    got = []
    for d in devs:
        try:
            os.close(os.open(d, os.O_RDONLY | os.O_NONBLOCK | os.O_NOCTTY))
            got.append(d)
        except OSError:
            pass
    return got


def a14(c):  # moving the folder above a read-only folder out of the way, and making a new one in its place
    if c.mode == 'outside':
        # Outside the walls the owner may rename it (checked by rights, not done: the proof's files must stay as they are).
        return ['may rename it'] if os.access(S, os.W_OK | os.X_OK) and os.path.isdir(P) else []
    try:
        os.rename(HELD, f'{HELD}-moved-{c.how}')
    except OSError:
        return []
    try:
        os.makedirs(P)
        write(f'{P}/target-run', b'changed')
    except OSError:
        pass
    return [f'renamed it ({c.how})']


def a19(c):  # swapping a job's own output folder for a link (the console mounts it at /out by its name)
    if c.mode == 'outside':
        return ['may rename it'] if os.access(JOBS, os.W_OK | os.X_OK) and os.path.isdir(JOB) else []
    try:
        os.rename(JOB, f'{JOB}-moved-{c.how}')
    except OSError:
        return []
    try:
        os.symlink(HOME, JOB)
    except OSError:
        pass
    return [f'renamed it ({c.how})']


def a20(c):  # ending a unit through the helper's stop: the owner's sudo line reaches it outside the walls, nothing inside
    got = []
    if quiet(['sudo', '-n', HELPER, 'stop', '--id', ID]):
        got.append('sudo -n the helper stop')
    if c.mode != 'outside' and quiet([HELPER, 'stop', '--id', ID]):
        got.append('the helper stop')
    return got


def a21(c):  # more memory than the change was given: its unit's memory.max must be the 2G the helper set (--memory)
    try:
        with open('/proc/self/cgroup') as f:
            path = f.read().strip().split('::', 1)[1]
        with open(f'/sys/fs/cgroup{path}/memory.max') as f:
            cap = f.read().strip()
    except (OSError, IndexError):
        return ['its memory cap could not be read']
    return [] if cap == str(2 << 30) else [f'memory.max is {cap}']


def a12(c):  # something left behind: a program put in the background, looked for from outside afterwards
    mark = f'{ID}-{c.mode}-{c.how}'
    subprocess.Popen(['sleep', '300'], env=dict(CLEAN, SPARK_PROOF_LEFT=mark), stdin=DEVNULL, stdout=DEVNULL,
                     stderr=DEVNULL, start_new_session=True)
    return [mark]


def guard_of(c):   # the guard the helper made for this wall's attempts
    return f"{ID[:38]}n{'l' if c.mode == 'look' else 'r'}"


def a15(c):  # stopping or changing the net's timer (looked at again from outside afterwards)
    g, got = guard_of(c), []
    for cmd in (['systemctl', 'stop', f'sw-guard-{g}.timer'], ['systemctl', 'kill', f'sw-guard-{g}.service'],
                ['systemd-run', f'--unit=sw-guard-{g}x', '--on-active=1', 'true']):
        if quiet(cmd):
            got.append(' '.join(cmd[:2]))
    return got


def a16(c):  # writing the net's copies or restore.sh: changing one, or adding a file beside them
    g, got = guard_of(c), []
    for name, flags in (('restore.sh', os.O_APPEND), ('guard.py', os.O_APPEND), ('manifest.json', os.O_APPEND),
                        (f'added-{c.how}', os.O_CREAT | os.O_EXCL)):
