    except OSError:
        pass
    return got


ATTEMPTS = {1: a1, 2: a2, 3: a3, 4: a4, 5: a5, 6: a6, 7: a7, 8: a8, 9: a9, 10: a10, 11: a11, 12: a12, 14: a14,
            15: a15, 16: a16, 17: a17, 18: a18, 19: a19, 20: a20, 21: a21}


def what(hits, n=0):
    return ', '.join(hits)[:200] if hits else REASONS.get(n, '-')


def attempts(mode, nums):
    for n in nums:
        if mode == 'outside':
            try:
                hits = ATTEMPTS[n](Ctx(mode, 'outside'))
                out('P', n, 'outside', 'works' if hits else 'not-there', what(hits, n))
            except Exception as e:
                out('P', n, 'outside', 'not-there', type(e).__name__)
            continue
        for how in ('direct', 'child'):
            try:
                if how == 'direct':
                    hits = ATTEMPTS[n](Ctx(mode, how))
                else:
                    r = subprocess.run([sys.executable, '-I', '-S', os.path.abspath(__file__), 'one', mode, str(n)],
                                       stdin=DEVNULL, stdout=subprocess.PIPE, stderr=DEVNULL, timeout=50)
                    hits = json.loads(r.stdout.decode().strip().splitlines()[-1])
            except Exception as e:
                out('P', n, how, 'failed', type(e).__name__)
                continue
            word = 'left' if (n, mode) in LEFT else ('through' if hits else 'blocked')
            out('P', n, how, word, what(hits))


def prep():
    os.umask(0o077)
    made = not os.path.lexists(SHARE)
    os.makedirs(SHARE, exist_ok=True)
    for old in glob.glob(f'{HOME}/.sparkie-proof-*') + glob.glob(f'{SHARE}/proof-*') + glob.glob(f'{JOBS}/sparkie-proof-*'):
        if os.path.islink(old):
            os.unlink(old)
        else:
            shutil.rmtree(old, ignore_errors=True)
    for d in (S, H, HELD, P):
        os.mkdir(d, 0o700)
    os.makedirs(JOB, 0o700)
    write(f'{H}/key', KEY)
    for w in ('look', 'run'):
        write(f'{H}/target-{w}', b'unchanged')
        write(f'{P}/target-{w}', b'unchanged')
        os.symlink(f'{H}/target-{w}', f'{S}/link-{w}')
        os.symlink(f'{P}/target-{w}', f'{S}/ro-{w}')
    os.symlink(f'{H}/key', f'{S}/key-link')
    for i, (_, path) in enumerate(SOCKETS):
        os.symlink(path, f'{S}/sock-{i}')
    own = None   # this Spark's own first address, as hostname -I lists them (no connection is made)
    try:
        listed = subprocess.run(['hostname', '-I'], stdin=DEVNULL, stdout=subprocess.PIPE, stderr=DEVNULL, env=CLEAN,
                                timeout=10).stdout.decode().split()
        own = next((a for a in listed if re.fullmatch(r'\d+\.\d+\.\d+\.\d+', a) and not a.startswith('127.')), None)
    except (OSError, subprocess.SubprocessError):
        pass
    handle = handle_of(f'{H}/key')
    with open(f'{S}/fixtures.json', 'w') as f:
        json.dump({'made_share': made, 'handle': handle, 'own': own, 'held': os.stat(HELD).st_ino, 'job': os.stat(JOB).st_ino}, f)
    # Without a handle the look wall's file-handle filter would be tried by nothing.
    out('S ok' if handle else 'S failed: no file handle for the proof key')


def setup():
    os.umask(0)
    stay, seen = [], set()
    with open('/proc/self/mountinfo') as f:
        for line in f:
            left, _, right = line.partition(' - ')
            fields, kind = left.split(), right.split()
            if len(fields) < 6 or not kind or kind[0] not in DISKS or 'ro' in fields[5].split(','):
                continue
            point = re.sub(r'\\([0-7]{3})', lambda m: chr(int(m.group(1), 8)), fields[4])
            if point in seen:
                continue
            seen.add(point)
            for old in glob.glob(os.path.join(glob.escape(point), '.spark-console-proof-*')):
                remove_dir(old)
            d = os.path.join(point, f'.spark-console-proof-{ID}')
            try:
                os.mkdir(d, 0o1777)
                stay.append(d)
            except OSError:
                pass
    fd = os.open(os.path.join(HERE, 'stay'), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, 'wb') as f:
        f.write(b'\0'.join(os.fsencode(d) for d in stay))
    # Without a folder on a disk, the look wall's read-only disks would be tried by nothing.
    out('S ok' if stay else 'S failed: no folder could be made on any disk')


def target():
    s = socket.socket()
    s.bind(('127.0.0.1', 0))
    s.listen(16)
    s.settimeout(1)
    write(f'{S}/port.new', str(s.getsockname()[1]).encode())
    os.replace(f'{S}/port.new', f'{S}/port')
    end = time.monotonic() + 300
    while time.monotonic() < end:
        try:
            s.accept()[0].close()
        except OSError:
            pass


def post():
    for w in ('look', 'run'):
