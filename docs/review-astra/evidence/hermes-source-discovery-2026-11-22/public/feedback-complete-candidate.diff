+def test_generic_skill_instruction_file_selects_the_same_runtime_tests_as_a_prompt():
+    # A skill steps.md / SKILL.md is a runtime behavior change, equivalent to an
+    # instruction under prompts/: it must select the same runtime-behavior suite.
+    for path in ('sparkie/skills/desk-assistant/steps.md',
+                 'sparkie/skills/fleet/steps.md',
+                 'sparkie/skills/fleet/SKILL.md'):
+        skill = select([path])
+        prompt = select(['sparkie/prompts/assistant.md'])
+        assert set(skill['python_tests']) == set(prompt['python_tests']), path
+        assert skill['compact_local_behavior'] is True, path
+        for name in ('test_fleet.py', 'test_energy.py', 'test_native_integration.py'):
+            assert 'tests/' + name in skill['python_tests'], (path, name)
