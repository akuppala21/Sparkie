+def _unconfirmed_terminal_in_tail(messages: list) -> bool:
+    """Match only actual terminal call IDs in the just-completed tool round."""
+    unconfirmed = set()
+    for message in reversed(messages):
+        if not isinstance(message, dict):
+            return False
+        if message.get("role") != "tool":
+            if not unconfirmed or message.get("role") != "assistant":
+                return False
+            return any(isinstance(call, dict) and isinstance(call.get("function"), dict)
+                       and call["function"].get("name") == "terminal"
+                       and (call.get("id") or call.get("call_id")) in unconfirmed
+                       for call in message.get("tool_calls") or [])
+        content = message.get("content")
+        call_id = message.get("tool_call_id")
+        if not isinstance(content, str) or not isinstance(call_id, str) or "remote_outcome_unknown" not in content:
+            continue
+        try:
+            outcome = json.loads(content)
+        except ValueError:
+            continue
+        if (isinstance(outcome, dict) and outcome.get("status") == "remote_outcome_unknown"
+                and "exit_code" in outcome and outcome["exit_code"] is None and outcome.get("error")):
+            unconfirmed.add(call_id)
+    return False
+
