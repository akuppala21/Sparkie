+def _single_patch_staging_error(payload, wa):
+    """Check an independent targeted patch; ordered batches retain native atomic replay."""
+    ops = payload.get("operations", [payload])
+    if len(ops) != 1:
+        return None
+    op = ops[0]
+    if op["action"] != "patch" or op.get("content"):
+        return None
+    if error := _op_shape_error("patch", op):
+        return error
+    name = op.get("name") or payload.get("name")
+    directory, error = _locate_for_write(name, "patch")
+    if error:
+        return error["error"]
+    label = op.get("file_path") or "SKILL.md"
+    target, error = _resolve_supporting_file(directory, label)
+    if error:
+        return error["error"]
+    if not target.is_file():
+        return f"Cannot read {label} in skill '{name}': target must be a regular file."
+    try:
+        original = target.read_text(encoding="utf-8-sig")
+    except (OSError, UnicodeError):
+        return f"Cannot read {label} in skill '{name}'."
+    folded, error = wa._fold_patch(original, op["old_string"], op["new_string"], op.get("replace_all"))
+    if error:
+        return f"Cannot patch {label} in skill '{name}': {error}. View this skill and copy its current text."
+    if error := _validate_content_size(folded, label=label):
+        return error
+    return None if op.get("file_path") else _validate_frontmatter(folded)
 
 
