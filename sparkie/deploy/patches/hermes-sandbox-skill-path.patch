+def _sandbox_skill_footer(skill_dir: Path, target: str, supporting: list[str], task_id: str | None):
+    """Render paths for the managed compute backend and its Docker qualification fixture.
+    Use the same declared roots as native mounts/sync. Never initialize a workspace here.
+    """
+    from tools.credential_files import _skill_dir_roots, _terminal_backend
+    backend = _terminal_backend()
+    if task_id:
+        from tools.terminal_tool import resolve_task_overrides
+        backend = resolve_task_overrides(task_id).get("env_type", backend)
+    if backend not in ("docker", "spark_compute"):
+        return None
+    from agent.skill_utils import EXCLUDED_SKILL_DIRS
+    from agent.terminal_env_registry import provider_flag
+    base = "/root/.hermes" if backend == "docker" else provider_flag(backend, "cache_path_base", None)
+    terminal_dir = None
+    for root, dest in _skill_dir_roots(base) if base else ():
+        if not skill_dir.is_relative_to(root):
+            continue
+        rel = skill_dir.relative_to(root)
+        # The native uploader omits symlinks and excluded directories. A package
+        # with mixed or unlisted paths gets the conservative skill_view footer.
+        for item in ["SKILL.md", *supporting]:
+            path = rel / item
+            if (path.is_absolute() or ".." in path.parts or EXCLUDED_SKILL_DIRS.intersection(path.parts)
+                    or not (root / path).is_file() or (root / path).resolve() != root.resolve() / path):
+                break
+        else:
+            terminal_dir = Path(dest) / rel
+        break
+    footer = ["", f"[Terminal skill directory: {terminal_dir}]" if terminal_dir else
+              "[This skill has no verified terminal directory. Use skill_view for linked files.]"]
+    if supporting:
+        footer.extend(f"- {item}" for item in supporting)
+        footer.append(f'Load a listed file with skill_view(name={json.dumps(target)}, file_path="<path>").')
+    footer.append(_SANDBOX_SKILL_FILES_END)
+    return footer
+
